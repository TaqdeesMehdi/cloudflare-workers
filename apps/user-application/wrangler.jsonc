/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "user-application",
  "main": "worker/index.ts",
  "compatibility_date": "2025-06-17",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  },
"env": {
  "stage":{
      "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-workers-stage",
      "database_id": "bd12a7eb-8c08-415a-b6b7-6f1aedb247a1",
      "remote": true
    }
  ],
  "services": [
    {
      "binding": "BACKEND_SERVICE",
      "service": "data-service-stage",
      "remote": true
    }
  ]
  },
  "production":{
      "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cloudflare-workers-production",
      "database_id": "341558a5-279d-4cb4-8334-c54e2f8b386e",
    
    }
  ],
  "services": [
    {
      "binding": "BACKEND_SERVICE",
      "service": "data-service-production",
      
    }
  ]
  }
}
  
}
