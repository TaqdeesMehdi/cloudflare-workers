/**
 * For more details on how to configure Wrangler, refer to:
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "data-service",
	"main": "src/index.ts",
	"compatibility_date": "2025-06-17",
	"compatibility_flags": ["nodejs_compat"],
	"observability": {
		"enabled": true
	},
"env": {
	"stage":{
			"browser": {
		"binding": "VIRTUAL_BROWSER"
	},
	"ai": {
		"binding":"AI"
	},
	"r2_buckets": [{
		"binding": "BUCKET",
		"bucket_name": "smart-links-eval-stage"
	}],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "bd12a7eb-8c08-415a-b6b7-6f1aedb247a1",
			"remote": true
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "01e0bee3d88f403ab23080e56a72c2a9",
			"remote": true
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "smart-links-data-queue-stage",
				"dead_letter_queue": "smart-links-data-dead-letter-queue-stage"
			},
			{
				"queue": "smart-links-data-dead-letter-queue-stage",
				"retry_delay": 0
			}
		],
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "smart-links-data-queue-stage"
			}
		]
	},
	"workflows": [
		{
			"binding": "DESTINATION_EVALUATION_WORKFLOW",
			"name": "destination-evaluation-workflow",
			"class_name": "DestinationEvaluationWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVALUATION_SCHEDULER",
				"class_name": "EvaluationScheduler"
			},
			{
				"name": "LINK_CLICK_TRACKER_OBJECT",
				"class_name": "LinkClickTracker"
			}
		]
	},
	"migrations": [{
		"tag": "v1",
		"new_sqlite_classes": ["EvaluationScheduler"]
	},{
		"tag": "v2",
		"new_sqlite_classes": ["LinkClickTracker"]
	}]
	},
	"production":{
		"browser": {
		"binding": "VIRTUAL_BROWSER"
	},
	"ai": {
		"binding":"AI"
	},
	"r2_buckets": [{
		"binding": "BUCKET",
		"bucket_name": "smart-links-eval-production"
	}],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "341558a5-279d-4cb4-8334-c54e2f8b386e"
		}
	],
	"kv_namespaces": [
		{
			"binding": "CACHE",
			"id": "2a3a965cef744ae18632760ccdf77a5d"
		}
	],
	"queues": {
		"consumers": [
			{
				"queue": "smart-links-data-queue-production",
				"dead_letter_queue": "smart-links-data-dead-letter-queue-production"
			},
			{
				"queue": "smart-links-data-dead-letter-queue-production",
				"retry_delay": 0
			}
		],
		"producers": [
			{
				"binding": "QUEUE",
				"queue": "smart-links-data-queue-production"
			}
		]
	},
	"workflows": [
		{
			"binding": "DESTINATION_EVALUATION_WORKFLOW",
			"name": "destination-evaluation-workflow-production",
			"class_name": "DestinationEvaluationWorkflow"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "EVALUATION_SCHEDULER",
				"class_name": "EvaluationScheduler"
			},
			{
				"name": "LINK_CLICK_TRACKER_OBJECT",
				"class_name": "LinkClickTracker"
			}
		]
	},
	"migrations": [{
		"tag": "v1",
		"new_sqlite_classes": ["EvaluationScheduler"]
	},{
		"tag": "v2",
		"new_sqlite_classes": ["LinkClickTracker"]
	}]
	}
}
}
